# Copia este archivo con el nombre ".env" y cambia los valores por los tuyos.
# El archivo ".env" NO se sube a GitHub (está en el .gitignore).
# Este ".env.example" SÍ se sube, por eso aquí no van datos reales.

# Puerto donde correrá el servidor (backend)
PORT=3000

# Dirección del frontend. Solo esa página podrá hablar con el backend (CORS)
