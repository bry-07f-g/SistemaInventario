# Copia este archivo con el nombre ".env" y cambia los valores por los tuyos.
# El archivo ".env" NO se sube a GitHub (está en el .gitignore).
# Este ".env.example" SÍ se sube, por eso aquí no van datos reales.

# Puerto donde correrá el servidor (backend)
PORT=3000

# Dirección del frontend. Solo esa página podrá hablar con el backend (CORS)
FRONTEND_URL=http://localhost:5173

# Datos de conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia_esta_clave
DB_NAME=inventario_db


# Conexión cifrada. Déjalo en false en tu computador; en una base en la
# nube (por ejemplo TiDB Cloud) ponlo en true.
DB_SSL=false

# Imágenes en la nube (Cloudinary). Déjalo comentado en tu computador: sin
# esto, las imágenes se guardan en backend/uploads.
# CLOUDINARY_URL=cloudinary://clave:secreto@nombre_de_tu_cuenta

# ---------------------------------------------------------------------
# Sesiones (versión 2)
# ---------------------------------------------------------------------
# Clave con la que se firman las sesiones. Mínimo 32 caracteres al azar.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si la cambias, todas las sesiones abiertas se cierran.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_al_azar_de_32_o_mas

# Super administrador: se crea solo al arrancar el servidor si no existe.
# Si olvidas su contraseña, cámbiala aquí y ejecuta: npm run reiniciar-admin
SUPERADMIN_NOMBRE=Super administrador
SUPERADMIN_EMAIL=admin@ejemplo.com
SUPERADMIN_PASSWORD=cambia_esta_clave

# Para reiniciar la contraseña del super admin en Render (sin terminal):
# cambia SUPERADMIN_PASSWORD, pon esta variable en true, y cuando el
# servicio arranque BÓRRALA.
# SUPERADMIN_REINICIAR=true